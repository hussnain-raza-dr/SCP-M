#!/bin/bash
# =============================================================================
# PBS Script — Improved Conditional GAN Training (SNGAN + TTUR + Hinge)
#              Multi-GPU via MPI + PyTorch DDP
# =============================================================================
# Submit:  qsub scripts/train_improved.pbs
# Monitor: qstat -u $USER
# Output:  logs/improved_train.out, logs/improved_train.err
#
# This job uses MPI to launch one process per GPU across nodes.
# Adjust select=N:ngpus=G for your cluster (N nodes, G GPUs per node).
# =============================================================================

# --- PBS Directives ---
#PBS -N cgan_improved
#PBS -l select=2:ncpus=8:ngpus=4:mem=48gb:mpiprocs=4
#PBS -l walltime=24:00:00
#PBS -q gpu
#PBS -o logs/improved_train.out
#PBS -e logs/improved_train.err
#PBS -m abe
## Uncomment and set your email:
## PBS -M your.email@university.edu

# --- Environment Setup ---
set -euo pipefail

cd "${PBS_O_WORKDIR:-$(dirname "$0")/..}"
PROJECT_DIR="$(pwd)"

echo "============================================="
echo " Improved GAN Training (MPI + DDP)"
echo " Job ID:    ${PBS_JOBID:-local}"
echo " Node:      $(hostname)"
echo " Date:      $(date)"
echo " Project:   ${PROJECT_DIR}"
echo "============================================="

mkdir -p "${PROJECT_DIR}/logs"

# Load cluster modules (adjust to your cluster)
# module purge
# module load python/3.10
# module load cuda/12.1
# module load cudnn/8.9
# module load openmpi/4.1

source "${PROJECT_DIR}/venv311/bin/activate"

# --- Determine MPI topology ---
NNODES=$(cat "${PBS_NODEFILE}" | sort -u | wc -l 2>/dev/null || echo 1)
GPUS_PER_NODE=$(nvidia-smi -L 2>/dev/null | wc -l || echo 1)
TOTAL_GPUS=$((NNODES * GPUS_PER_NODE))

echo ""
echo "--- Cluster Topology ---"
echo "Nodes:         ${NNODES}"
echo "GPUs per node: ${GPUS_PER_NODE}"
echo "Total GPUs:    ${TOTAL_GPUS}"

# Show GPU info
echo ""
echo "--- GPU Info ---"
nvidia-smi --query-gpu=name,memory.total,driver_version --format=csv,noheader 2>/dev/null || echo "nvidia-smi not available"
python -c "import torch; print(f'CUDA available: {torch.cuda.is_available()}'); print(f'Devices: {torch.cuda.device_count()}') if torch.cuda.is_available() else None"
echo ""

# --- Pick a free master port ---
MASTER_PORT=$(python -c "import socket; s=socket.socket(); s.bind(('',0)); print(s.getsockname()[1]); s.close()")
MASTER_ADDR=$(head -1 "${PBS_NODEFILE}" 2>/dev/null || echo "localhost")
export MASTER_ADDR MASTER_PORT

echo "--- Distributed Config ---"
echo "MASTER_ADDR: ${MASTER_ADDR}"
echo "MASTER_PORT: ${MASTER_PORT}"
echo ""

# --- Run Training via MPI ---
echo "--- Starting Improved Training (MPI + DDP) ---"
echo "Config: config/improved_config.yaml"
echo "Epochs: 400, Batch size: 64 per GPU, Loss: Hinge"
echo ""

mpirun -np "${TOTAL_GPUS}" \
    --hostfile "${PBS_NODEFILE}" \
    --bind-to none \
    -x MASTER_ADDR \
    -x MASTER_PORT \
    -x PATH \
    -x LD_LIBRARY_PATH \
    -x PYTHONPATH \
    -x CUDA_VISIBLE_DEVICES \
    python training/train.py \
        --config config/improved_config.yaml

echo ""
echo "--- Improved Training Complete ---"
echo "Checkpoints: ${PROJECT_DIR}/checkpoints_improved/"
echo "Results:     ${PROJECT_DIR}/results_improved/"
echo "Finished:    $(date)"
