#!/bin/bash
# =============================================================================
# PBS Script — Baseline Conditional GAN Training
# =============================================================================
# Submit:  qsub scripts/train_baseline.pbs
# Monitor: qstat -u $USER
# Output:  logs/baseline_train.out, logs/baseline_train.err
# =============================================================================

# --- PBS Directives ---
#PBS -N cgan_baseline
#PBS -l select=1:ncpus=4:ngpus=1:mem=16gb
#PBS -l walltime=04:00:00
#PBS -q gpu
#PBS -o logs/baseline_train.out
#PBS -e logs/baseline_train.err
#PBS -m abe
## Uncomment and set your email:
## PBS -M your.email@university.edu

# --- Environment Setup ---
set -euo pipefail

# Navigate to project directory
cd "${PBS_O_WORKDIR:-$(dirname "$0")/..}"
PROJECT_DIR="$(pwd)"

echo "============================================="
echo " Baseline GAN Training"
echo " Job ID:    ${PBS_JOBID:-local}"
echo " Node:      $(hostname)"
echo " Date:      $(date)"
echo " Project:   ${PROJECT_DIR}"
echo "============================================="

# Create log directory
mkdir -p "${PROJECT_DIR}/logs"

# --- Sync latest code from Git ---
echo ""
echo "--- Git Sync ---"
cd "${PROJECT_DIR}"
git fetch origin
git pull origin "$(git rev-parse --abbrev-ref HEAD)"
echo "Current commit: $(git log --oneline -1)"
echo ""

# Load cluster modules (adjust to your cluster)
# module purge
# module load python/3.10
# module load cuda/12.1
# module load cudnn/8.9

# Activate virtual environment
source "${PROJECT_DIR}/venv/bin/activate"

# Verify GPU availability
echo ""
echo "--- GPU Info ---"
nvidia-smi --query-gpu=name,memory.total,driver_version --format=csv,noheader 2>/dev/null || echo "nvidia-smi not available"
python -c "import torch; print(f'CUDA available: {torch.cuda.is_available()}'); print(f'Device: {torch.cuda.get_device_name(0)}') if torch.cuda.is_available() else None"
echo ""

# --- Run Training ---
echo "--- Starting Baseline Training ---"
echo "Config: config/baseline_config.yaml"
echo "Epochs: 50, Batch size: 128, Loss: vanilla"
echo ""

python training/train.py \
    --config config/baseline_config.yaml

echo ""
echo "--- Baseline Training Complete ---"
echo "Checkpoints: ${PROJECT_DIR}/checkpoints/"
echo "Results:     ${PROJECT_DIR}/results/"
echo "Finished:    $(date)"
