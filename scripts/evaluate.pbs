#!/bin/bash
# =============================================================================
# PBS Script — Evaluate both baseline and improved models
# =============================================================================
# Submit after BOTH training jobs finish:
#   qsub -W depend=afterok:<baseline_jobid>:<improved_jobid> scripts/evaluate.pbs
#
# Or submit standalone (if checkpoints already exist):
#   qsub scripts/evaluate.pbs
#
# This runs evaluation + FID computation for both models and produces
# side-by-side comparison metrics.
# =============================================================================

# --- PBS Directives ---
#PBS -N cgan_evaluate
#PBS -l select=1:ncpus=4:ngpus=1:mem=16gb
#PBS -l walltime=02:00:00
#PBS -q gpu
#PBS -o logs/evaluate.out
#PBS -e logs/evaluate.err
#PBS -m abe
## Uncomment and set your email:
## PBS -M your.email@university.edu

# --- Environment Setup ---
set -euo pipefail

cd "${PBS_O_WORKDIR:-$(dirname "$0")/..}"
PROJECT_DIR="$(pwd)"

echo "============================================="
echo " GAN Evaluation — Baseline vs Improved"
echo " Job ID:    ${PBS_JOBID:-local}"
echo " Node:      $(hostname)"
echo " Date:      $(date)"
echo " Project:   ${PROJECT_DIR}"
echo "============================================="

mkdir -p "${PROJECT_DIR}/logs"

# --- Sync latest code from Git ---
echo ""
echo "--- Git Sync ---"
cd "${PROJECT_DIR}"
git fetch origin
git pull origin "$(git rev-parse --abbrev-ref HEAD)"
echo "Current commit: $(git log --oneline -1)"
echo ""

# Load cluster modules (adjust to your cluster)
# module purge
# module load python/3.10
# module load cuda/12.1
# module load cudnn/8.9

source "${PROJECT_DIR}/venv/bin/activate"

# Verify GPU
echo ""
echo "--- GPU Info ---"
nvidia-smi --query-gpu=name,memory.total,driver_version --format=csv,noheader 2>/dev/null || echo "nvidia-smi not available"
echo ""

# =============================================================================
# 1. Evaluate Baseline Model
# =============================================================================
BASELINE_CKPT="${PROJECT_DIR}/checkpoints/checkpoint_final.pt"
BASELINE_EVAL_DIR="${PROJECT_DIR}/results/evaluation"

if [ -f "${BASELINE_CKPT}" ]; then
    echo "=== Evaluating Baseline Model ==="
    echo "Checkpoint: ${BASELINE_CKPT}"
    echo ""

    python evaluation/evaluate.py \
        --checkpoint "${BASELINE_CKPT}" \
        --config config/baseline_config.yaml \
        --output "${BASELINE_EVAL_DIR}" \
        --compute-fid \
        --fid-samples 5000

    echo ""
    echo "Baseline evaluation saved to: ${BASELINE_EVAL_DIR}"
else
    echo "WARNING: Baseline checkpoint not found at ${BASELINE_CKPT}"
    echo "  Run train_baseline.pbs first."
fi

echo ""
echo "=================================================="
echo ""

# =============================================================================
# 2. Evaluate Improved Model
# =============================================================================
IMPROVED_CKPT="${PROJECT_DIR}/checkpoints_improved/checkpoint_final.pt"
IMPROVED_EVAL_DIR="${PROJECT_DIR}/results_improved/evaluation"

if [ -f "${IMPROVED_CKPT}" ]; then
    echo "=== Evaluating Improved Model ==="
    echo "Checkpoint: ${IMPROVED_CKPT}"
    echo ""

    python evaluation/evaluate.py \
        --checkpoint "${IMPROVED_CKPT}" \
        --config config/improved_config.yaml \
        --output "${IMPROVED_EVAL_DIR}" \
        --compute-fid \
        --fid-samples 5000

    echo ""
    echo "Improved evaluation saved to: ${IMPROVED_EVAL_DIR}"
else
    echo "WARNING: Improved checkpoint not found at ${IMPROVED_CKPT}"
    echo "  Run train_improved.pbs first."
fi

# =============================================================================
# 3. Print Side-by-Side Comparison
# =============================================================================
echo ""
echo "=================================================="
echo " COMPARISON SUMMARY"
echo "=================================================="

python -c "
import json, os

baseline_path = '${BASELINE_EVAL_DIR}/evaluation_metrics.json'
improved_path = '${IMPROVED_EVAL_DIR}/evaluation_metrics.json'

results = {}
for name, path in [('Baseline', baseline_path), ('Improved', improved_path)]:
    if os.path.exists(path):
        with open(path) as f:
            results[name] = json.load(f)
    else:
        print(f'{name}: metrics not found at {path}')

if len(results) == 2:
    print(f'')
    print(f'{\"Metric\":<35s} {\"Baseline\":>12s} {\"Improved\":>12s} {\"Delta\":>10s}')
    print(f'{\"-\"*35} {\"-\"*12} {\"-\"*12} {\"-\"*10}')

    for key in ['real_accuracy', 'fake_accuracy', 'total_accuracy']:
        b = results['Baseline'][key]
        i = results['Improved'][key]
        d = i - b
        sign = '+' if d > 0 else ''
        print(f'{key:<35s} {b:>11.4f}  {i:>11.4f}  {sign}{d:>8.4f}')

    for key in ['pixel_mean', 'pixel_std']:
        b = results['Baseline']['output_stats'][key]
        i = results['Improved']['output_stats'][key]
        d = i - b
        sign = '+' if d > 0 else ''
        print(f'{key:<35s} {b:>11.4f}  {i:>11.4f}  {sign}{d:>8.4f}')

    if 'fid_score' in results['Baseline'] and 'fid_score' in results['Improved']:
        b = results['Baseline']['fid_score']
        i = results['Improved']['fid_score']
        d = i - b
        sign = '+' if d > 0 else ''
        print(f'{\"fid_score (lower=better)\":<35s} {b:>11.2f}  {i:>11.2f}  {sign}{d:>8.2f}')

    print(f'')
    print(f'Per-class D(G(z)) scores (lower = G fools D better):')
    print(f'{\"Class\":<15s} {\"Baseline\":>10s} {\"Improved\":>10s}')
    b_gen = results['Baseline']['generation_quality_per_class']
    i_gen = results['Improved']['generation_quality_per_class']
    for cls in b_gen:
        if cls in i_gen:
            print(f'{cls:<15s} {b_gen[cls]:>10.4f} {i_gen[cls]:>10.4f}')
elif len(results) == 1:
    name = list(results.keys())[0]
    r = results[name]
    print(f'Only {name} results available:')
    print(f'  Real acc: {r[\"real_accuracy\"]:.4f}')
    print(f'  Fake acc: {r[\"fake_accuracy\"]:.4f}')
    if 'fid_score' in r:
        print(f'  FID: {r[\"fid_score\"]:.2f}')
"

echo ""
echo "=================================================="
echo " Evaluation Complete — $(date)"
echo "=================================================="
